(ns agri-technician.operations
  "The closed vocabulary of field operations this actor may propose.

  Before this catalog the governor judged a proposal by its technician, its
  farm, its `:effect`, its confidence and one named escalation — and accepted
  every other `:op` it had never heard of. The advisor is swappable and
  `llm-advisor` passes through whatever `:op` the model wrote, so
  `{:op :apply-pesticide :effect :propose :confidence 0.9}` for a verified
  technician's supervised farm came back `:ok? true` and was committed as a
  technical record with no human sign-off. This is the allow-list the
  governor now checks against.

  Two kinds of op:
    permitted  — may be proposed; the governor still applies its other rules.
    anything else — unknown, and a hard `:unknown-op` block. That includes
                 `:unknown`, which `advisor/parse-proposal` emits when the
                 model's reply could not be read: there is no proposal to
                 approve, so it holds rather than asking a human to sign off
                 on nothing.")

(def permitted
  "Ops the advisor may propose, with what each one produces."
  {:log-site-assessment    "a field data / site assessment entry under the supervised farm"
   :run-test-protocol      "a crop or soil test protocol result for the farm"
   :flag-pest-disease-risk "a pest / disease risk for a human to review (always escalates)"
   :schedule-site-visit    "a proposed site visit on the farm's schedule"})

(defn permitted? [op] (contains? permitted op))

(defn unknown?
  "True for an op the catalog does not permit."
  [op]
  (not (permitted? op)))
